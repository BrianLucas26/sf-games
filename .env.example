# Supabase project settings (Project Settings -> API in the Supabase dashboard)
# Use the publishable key here, never the secret key -- this file ships to the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Mapbox GL JS (mapbox.com -> Account -> Access tokens). Free tier: 50k map loads/mo.
VITE_MAPBOX_TOKEN=pk.your-mapbox-token

# Cloudflare Turnstile site key (dash.cloudflare.com -> Turnstile -> your site).
# The matching secret key is server-only -- set via
# `npx supabase secrets set TURNSTILE_SECRET=...`, never put it here.
VITE_TURNSTILE_SITE_KEY=0x0000000000000000000000AA

# Optional: comma-separated game slugs to unlock despite being "Coming Soon!"
# (src/lib/comingSoon.ts). Local dev only -- leave unset in production.
# VITE_UNLOCKED_GAMES=turf-war,hide-and-seek
